        <hashTree>
          <IncludeController guiclass="IncludeControllerGui" testclass="IncludeController" testname="Include Squad D" enabled="true">
            <stringProp name="IncludeController.includepath">../squads/squad-d/script-fragment.jmx</stringProp>
